# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgres://racecontrol:racecontrol@localhost:5432/racecontrol?sslmode=disable
HTTP_ADDR=:8080

# Argon2id parameters (memory in KiB, iterations, parallelism).
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Session lifetimes.
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h