# Copy to .env and adjust. Never commit the real .env.

# development | production. Setting production refuses to start if
# SEED_DEMO_PASSWORD is present.
APP_ENV=development

DATABASE_URL=postgres://racecontrol:racecontrol@localhost:5432/racecontrol?sslmode=disable
HTTP_ADDR=:8080

# Password given to the demo accounts created by `make seed` outside production.
# Leave empty in production: the process refuses to start when it is set.
SEED_DEMO_PASSWORD=

# Argon2id parameters (memory in KiB, iterations, parallelism).
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Session lifetimes.
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h
# Comma-separated origins allowed to call the API from a browser (the Expo web
# dev server). In production the app is served from the API's own origin.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
